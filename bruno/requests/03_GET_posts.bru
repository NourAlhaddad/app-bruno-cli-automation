meta {
  name: Get Posts with Query Params
  type: http
  seq: 3
}

get {
  url: https://jsonplaceholder.typicode.com/posts?userId=1
  body: none
}

tests {
  test("Status should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response should be an array", function() {
    expect(res.getBody()).to.be.an('array');
  });
  
  test("Should have posts for userId 1", function() {
    const posts = res.getBody();
    expect(posts.length).to.be.greaterThan(0);
  });
  
  test("All posts should have userId 1", function() {
    const posts = res.getBody();
    posts.forEach(post => {
      expect(post.userId).to.equal(1);
    });
  });
  
  test("Each post should have required fields", function() {
    const posts = res.getBody();
    posts.forEach(post => {
      expect(post).to.have.property('id');
      expect(post).to.have.property('title');
      expect(post).to.have.property('body');
      expect(post).to.have.property('userId');
    });
  });
}
