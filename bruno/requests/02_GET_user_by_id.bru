meta {
  name: Get User by ID
  type: http
  seq: 2
}

get {
  url: https://jsonplaceholder.typicode.com/users/1
  body: none
}

tests {
  test("Status should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response should be an object", function() {
    expect(res.getBody()).to.be.an('object');
  });
  
  test("User ID should be 1", function() {
    const body = res.getBody();
    expect(body.id).to.equal(1);
  });
  
  test("User should have correct name", function() {
    const body = res.getBody();
    expect(body.name).to.equal('Leanne Graham');
  });
  
  test("User should have email property", function() {
    const body = res.getBody();
    expect(body.email).to.exist;
    expect(body.email).to.be.a('string');
  });
}
